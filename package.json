{
  "name": "rheajt.github.io",
  "private": true,
  "description": "portfolio site built with SolidStart and Bun",
  "version": "4.0.0",
  "author": "jordan rhea <rheajt@gmail.com>",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 4444",
    "build": "vite build",
    "start": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build-smoke": "bun run scripts/build-smoke.ts",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy": "bun run build && gh-pages -d .output/public --dotfiles"
  },
  "dependencies": {
    "@sanity/client": "^8.7.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "prismjs": "^1.30.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15",
    "solid-styled-components": "^0.28.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/prismjs": "^1.26.6",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.1",
    "nitro": "^3.0.260903-beta",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  },
  "homepage": "https://jordanrhea.com",
  "keywords": [
    "solidjs",
    "solidstart",
    "portfolio"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rheajt/rheajt.github.io.git"
  }
}
